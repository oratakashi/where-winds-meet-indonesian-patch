#!/bin/sh
# Aktifkan sekali per clone:  git config core.hooksPath .githooks
#
# Kalau commit menyentuh data terjemahan, pastikan file locale valid dan blok
# progress di Current-Status.md sudah diperbarui (tools/wwm.sh progress --write).
# tools/wwm.sh memakai binary Rust `wwm` kalau sudah di-build, selain itu Python
# (WWM_TOOLCHAIN=python memaksa Python).
WWM="sh tools/wwm.sh"

# WWM China (profil cn) — data di cn/, status di Obsidian-Vault/cn/.
staged_cn=$(git diff --cached --name-only -- cn/locale cn/translation_work cn/overrides.jsonl \
            Obsidian-Vault/cn/progress/CN-Current-Status.md tools rust)
if [ -n "$staged_cn" ]; then
    $WWM qa --profile cn --locale "cn/locale/*.jsonl" || {
        echo "pre-commit: qa --profile cn --locale menemukan masalah — perbaiki dulu." >&2
        exit 1
    }
    $WWM progress --profile cn --check || {
        echo "pre-commit: jalankan 'sh tools/wwm.sh progress --profile cn --write', lalu git add" >&2
        echo "            Obsidian-Vault/cn/progress/CN-Current-Status.md dan commit ulang." >&2
        exit 1
    }
fi

staged=$(git diff --cached --name-only -- locale translation_work translate_words_map_en \
         Obsidian-Vault/progress/Current-Status.md tools rust)
[ -z "$staged" ] && exit 0

$WWM qa --locale "locale/*.jsonl" || {
    echo "pre-commit: qa --locale menemukan masalah — perbaiki dulu." >&2
    exit 1
}
$WWM progress --check || {
    echo "pre-commit: jalankan 'sh tools/wwm.sh progress --write', lalu git add" >&2
    echo "            Obsidian-Vault/progress/Current-Status.md dan commit ulang." >&2
    exit 1
}
